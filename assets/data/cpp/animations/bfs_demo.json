{
  "animationId": "cpp_bfs_demo",
  "itemId": "2.7.2",
  "title": "BFS 广度优先搜索",
  "description": "演示 BFS 从起点出发逐层扩展的遍历过程，使用队列实现",
  "initialState": {
    "variables": [],
    "containers": [
      {"name": "visited", "type": "bool[]", "values": ["0", "0", "0", "0", "0"], "activeIndex": -1, "note": "0=未访问"},
      {"name": "队列 Q", "type": "queue", "values": [], "activeIndex": -1, "note": "BFS 用队列"}
    ],
    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "起点 0 入队",
      "description": "BFS 从节点 0 开始。将 0 入队，标记 visited[0]=1。队列：[0]。",
      "codeLine": "Q.push(0); visited[0] = true;",
      "highlights": ["Q.push(0)", "visited[0]"],
      "state": {
        "variables": [
          {"name": "当前层", "value": "0", "note": "第 0 层"},
          {"name": "访问序", "value": "0", "note": ""}
        ],
        "containers": [
          {"name": "visited", "type": "bool[]", "values": ["1", "0", "0", "0", "0"], "activeIndex": 0, "note": ""},
          {"name": "队列 Q", "type": "queue", "values": ["0"], "activeIndex": 0, "note": ""}
        ],
        "output": "0"
      }
    },
    {
      "step": 2,
      "title": "弹出 0，邻居 1,3 入队",
      "description": "弹出队首 0，将其未访问邻居 1 和 3 依次入队。BFS 按层扩展。",
      "codeLine": "int u = Q.front(); Q.pop();  // u=0",
      "highlights": ["Q.front()", "Q.pop()"],
      "state": {
        "variables": [
          {"name": "当前层", "value": "1", "note": "第 1 层"},
          {"name": "访问序", "value": "0 → 1 → 3", "note": ""}
        ],
        "containers": [
          {"name": "visited", "type": "bool[]", "values": ["1", "1", "0", "1", "0"], "activeIndex": 3, "note": ""},
          {"name": "队列 Q", "type": "queue", "values": ["1", "3"], "activeIndex": 0, "note": ""}
        ],
        "output": "0 → 1 → 3"
      }
    },
    {
      "step": 3,
      "title": "弹出 1，邻居 2 入队",
      "description": "弹出队首 1，邻居 0 已访问（跳过），邻居 2 未访问，入队。",
      "codeLine": "int u = Q.front(); Q.pop();  // u=1",
      "highlights": ["Q.front()", "Q.pop()"],
      "state": {
        "variables": [
          {"name": "当前层", "value": "2", "note": "第 2 层"},
          {"name": "访问序", "value": "0 → 1 → 3 → 2", "note": ""}
        ],
        "containers": [
          {"name": "visited", "type": "bool[]", "values": ["1", "1", "1", "1", "0"], "activeIndex": 2, "note": ""},
          {"name": "队列 Q", "type": "queue", "values": ["3", "2"], "activeIndex": 0, "note": ""}
        ],
        "output": "0 → 1 → 3 → 2"
      }
    },
    {
      "step": 4,
      "title": "弹出 3，邻居 4 入队",
      "description": "弹出 3，邻居 0 已访问（跳过），邻居 4 未访问，入队。",
      "codeLine": "int u = Q.front(); Q.pop();  // u=3",
      "highlights": ["Q.front()", "Q.pop()"],
      "state": {
        "variables": [
          {"name": "当前层", "value": "2", "note": "仍在第 2 层"},
          {"name": "访问序", "value": "0 → 1 → 3 → 2 → 4", "note": ""}
        ],
        "containers": [
          {"name": "visited", "type": "bool[]", "values": ["1", "1", "1", "1", "1"], "activeIndex": 4, "note": "全部访问 ✓"},
          {"name": "队列 Q", "type": "queue", "values": ["2", "4"], "activeIndex": 0, "note": ""}
        ],
        "output": "0 → 1 → 3 → 2 → 4"
      }
    },
    {
      "step": 5,
      "title": "BFS 完成",
      "description": "继续弹出 2 和 4，没有新的未访问邻居。队列为空，BFS 结束。BFS 按层遍历，最先到达的路径最短。",
      "codeLine": "while (!Q.empty()) { ... }",
      "highlights": ["!Q.empty()"],
      "state": {
        "variables": [
          {"name": "结果", "value": "完成", "note": "按层遍历，可用于求最短路"}
        ],
        "containers": [
          {"name": "visited", "type": "bool[]", "values": ["1", "1", "1", "1", "1"], "activeIndex": -1, "note": "全部访问 ✓"},
          {"name": "队列 Q", "type": "queue", "values": [], "activeIndex": -1, "note": "队列空，结束"}
        ],
        "output": "BFS 序：0 → 1 → 3 → 2 → 4"
      }
    }
  ]
}
