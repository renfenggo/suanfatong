        ],
        "containers": [
          {"name": "arr", "type": "int[]", "values": ["2", "5", "8", "12", "16", "23", "38"], "activeIndex": 5, "note": "中间值 23"}
        ],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "比较：23 > 16，缩小右边界",
      "description": "arr[mid]=23 > target=16，说明目标在左半部分。将 right 移到 mid - 1 = 4。",
      "codeLine": "else if (arr[mid] > target) right = mid - 1;",
      "highlights": ["arr[mid] > target", "right = mid - 1"],
      "state": {
        "variables": [
          {"name": "target", "value": "16", "note": ""},
          {"name": "left", "value": "4", "note": ""},
