          {"name": "mid", "value": "3", "note": "12 < 16，去右边"}
        ],
        "containers": [
          {"name": "arr", "type": "int[]", "values": ["2", "5", "8", "12", "16", "23", "38"], "activeIndex": 3, "note": "排除左半部分"}
        ],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "新的 mid = 5",
      "description": "重新计算 mid = (4 + 6) / 2 = 5。arr[5] = 23。",
      "codeLine": "mid = (left + right) / 2;",
      "highlights": ["mid"],
      "state": {
        "variables": [
          {"name": "target", "value": "16", "note": ""},
          {"name": "left", "value": "4", "note": ""},
