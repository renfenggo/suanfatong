    "output": "访问序列："
  },
  "steps": [
    {
      "step": 1,
      "title": "访问起点 0",
      "description": "进入 dfs(0)，先把 0 标记为已访问。DFS 每到一个新点，第一件事就是 visited[u] = true。",
      "codeLine": "void dfs(int u) { visited[u] = true; }  // u = 0",
      "highlights": ["dfs(0)", "visited[0]"],
      "state": {
        "variables": [
          {"name": "当前节点", "value": "0", "note": "刚进入 dfs(0)"},
