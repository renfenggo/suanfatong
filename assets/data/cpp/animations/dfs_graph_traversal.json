        "name": "DFS 图",
        "type": "graph",
        "values": [
          {"id": "0", "status": "unvisited"},
          {"id": "1", "status": "unvisited"},
          {"id": "2", "status": "unvisited"},
          {"id": "3", "status": "unvisited"},
          {"id": "4", "status": "unvisited"},
          {"id": "5", "status": "unvisited"}
