            "type": "graph",
            "values": [
              {"id": "0", "status": "active"},
              {"id": "1", "status": "unvisited"},
              {"id": "2", "status": "unvisited"},
              {"id": "3", "status": "unvisited"},
              {"id": "4", "status": "unvisited"},
              {"id": "5", "status": "unvisited"}
            ],
            "activeIndex": 0,
            "note": "红色是当前节点，蓝色是已经访问过的节点"
          },
          {
            "name": "visited",
            "type": "bool[]",
            "values": ["1", "0", "0", "0", "0", "0"],
            "activeIndex": 0,
            "note": "0 已访问"
          },
          {
            "name": "递归栈",
            "type": "stack",
            "values": ["dfs(0)"],
            "activeIndex": 0,
            "note": "当前在 dfs(0)"
