      "codeLine": "if (grid[0][0]=='1' && !visited[0][0]) dfs(0,0);",
      "highlights": ["grid[0][0]", "visited[0][0]", "dfs(0,0)"],
      "state": {
        "variables": [
          {"name": "当前坐标", "value": "(0,0)", "note": "扫描发现陆地"},
