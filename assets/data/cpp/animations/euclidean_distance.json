{
  "animationId": "cpp_euclidean_distance",
  "itemId": "4.7.12",
  "title": "欧氏距离",
  "description": "演示计算平面上两点之间欧氏距离的过程：勾股定理的应用",
  "initialState": {
    "variables": [
      {"name": "x1", "value": "1", "note": ""},
      {"name": "y1", "value": "2", "note": ""},
      {"name": "x2", "value": "4", "note": ""},
      {"name": "y2", "value": "6", "note": ""}
    ],
    "containers": [],
    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "已知两点坐标",
      "description": "点 A(1, 2) 和点 B(4, 6)，求它们之间的欧氏距离",
      "codeLine": "double x1=1, y1=2, x2=4, y2=6;",
      "highlights": ["x1", "y1", "x2", "y2"],
      "state": {
        "variables": [
          {"name": "A", "value": "(1,2)", "note": ""},
          {"name": "B", "value": "(4,6)", "note": ""}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "计算坐标差",
      "description": "dx = x2 - x1 = 4 - 1 = 3，dy = y2 - y1 = 6 - 2 = 4",
      "codeLine": "double dx = x2 - x1, dy = y2 - y1;",
      "highlights": ["dx", "dy"],
      "state": {
        "variables": [
          {"name": "A", "value": "(1,2)", "note": ""},
          {"name": "B", "value": "(4,6)", "note": ""},
          {"name": "dx", "value": "3", "note": "4-1=3"},
          {"name": "dy", "value": "4", "note": "6-2=4"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "平方求和",
      "description": "dx² + dy² = 3² + 4² = 9 + 16 = 25（勾股定理）",
      "codeLine": "double sum = dx*dx + dy*dy;",
      "highlights": ["dx*dx + dy*dy"],
      "state": {
        "variables": [
          {"name": "dx", "value": "3", "note": ""},
          {"name": "dy", "value": "4", "note": ""},
          {"name": "dx²+dy²", "value": "25", "note": "9+16=25"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "开方得距离",
      "description": "d = √25 = 5.0。两点之间的欧氏距离为 5.0",
      "codeLine": "double d = sqrt(dx*dx + dy*dy);",
      "highlights": ["sqrt"],
      "state": {
        "variables": [
          {"name": "dx²+dy²", "value": "25", "note": ""},
          {"name": "d", "value": "5.0", "note": "√25 = 5.0"}
        ],
        "containers": [],
        "output": "5.0"
      }
    },
    {
      "step": 5,
      "title": "公式总结",
      "description": "欧氏距离公式：d = √((x2-x1)² + (y2-y1)²)，本质是勾股定理在坐标系中的推广",
      "codeLine": "// d = sqrt((x2-x1)^2 + (y2-y1)^2)",
      "highlights": [],
      "state": {
        "variables": [
          {"name": "A", "value": "(1,2)", "note": ""},
          {"name": "B", "value": "(4,6)", "note": ""},
          {"name": "d", "value": "5.0", "note": ""}
        ],
        "containers": [],
        "output": "distance = 5.0"
      }
    }
  ]
}
