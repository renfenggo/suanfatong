        "containers": [],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "取模验证",
      "description": "729 % 7 = 1 ✓。费马小定理成立",
      "codeLine": "cout << 729 % 7; // = 1 ✓",
      "highlights": ["729 % 7"],
      "state": {
        "variables": [
          {"name": "3^6", "value": "729", "note": ""},
          {"name": "729%7", "value": "1", "note": "✓ 费马小定理成立"}
        ],
        "containers": [],
        "output": "3^6 % 7 = 1 ✓"
      }
    },
    {
      "step": 4,
      "title": "应用：求逆元",
      "description": "由 a^(p-1) ≡ 1 可得 a^(p-2) ≡ a^(-1) (mod p)。即 a 的逆元 = a^(p-2) mod p",
      "codeLine": "// inv(a) = a^(p-2) mod p",
      "highlights": ["a^(p-2)"],
