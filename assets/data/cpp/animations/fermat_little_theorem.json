        "variables": [
          {"name": "a", "value": "3", "note": ""},
          {"name": "p", "value": "7", "note": "质数"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "验证：3^6 mod 7",
      "description": "3^6 = 729，计算 729 % 7",
      "codeLine": "// 3^6 = 729",
      "highlights": ["3^6"],
      "state": {
        "variables": [
          {"name": "3^1", "value": "3", "note": ""},
          {"name": "3^2", "value": "9", "note": ""},
          {"name": "3^3", "value": "27", "note": ""},
          {"name": "3^6", "value": "729", "note": "3^3×3^3"}
