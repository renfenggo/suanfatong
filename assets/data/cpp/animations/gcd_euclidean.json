  "steps": [
    {
      "step": 1,
      "title": "初始化",
      "description": "令 a = 48, b = 18，目标是求 gcd(48, 18)",
      "codeLine": "int a = 48, b = 18;",
      "highlights": ["a", "b"],
      "state": {
        "variables": [
          {"name": "a", "value": "48", "note": ""},
          {"name": "b", "value": "18", "note": ""}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "第 1 轮：48 % 18",
      "description": "48 ÷ 18 = 2 余 12，所以 a=18, b=12",
      "codeLine": "int r = a % b; a = b; b = r;",
      "highlights": ["a % b"],
      "state": {
        "variables": [
          {"name": "a", "value": "18", "note": "48%18=12"},
          {"name": "b", "value": "12", "note": ""},
          {"name": "r", "value": "12", "note": "48÷18=2余12"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "第 2 轮：18 % 12",
      "description": "18 ÷ 12 = 1 余 6，所以 a=12, b=6",
      "codeLine": "r = a % b; a = b; b = r;",
      "highlights": ["a % b"],
      "state": {
        "variables": [
          {"name": "a", "value": "12", "note": "18%12=6"},
          {"name": "b", "value": "6", "note": ""},
          {"name": "r", "value": "6", "note": "18÷12=1余6"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "第 3 轮：12 % 6",
      "description": "12 ÷ 6 = 2 余 0，b 变为 0，循环结束",
      "codeLine": "r = a % b; a = b; b = r;",
      "highlights": ["a % b"],
      "state": {
        "variables": [
          {"name": "a", "value": "6", "note": "12%6=0"},
          {"name": "b", "value": "0", "note": "余数为 0，结束"},
          {"name": "r", "value": "0", "note": "12÷6=2余0"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 5,
      "title": "得到结果",
      "description": "当 b=0 时，a 就是 gcd。所以 gcd(48, 18) = 6",
      "codeLine": "cout << a; // gcd = 6",
      "highlights": ["a"],
      "state": {
        "variables": [
          {"name": "gcd", "value": "6", "note": "gcd(48,18)=6"}
