        "containers": [
          {"name": "物品", "type": "物品[]", "values": ["A(重2,值3)", "B(重3,值4)", "C(重4,值5)"], "activeIndex": 2, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 5,
      "title": "最终答案 dp[3][6] = 8",
      "description": "01 背包的转移方程：dp[i][j] = max(不选, 选)。核心：每个物品只有「选」或「不选」两种决策。时间 O(n×W)。",
      "codeLine": "cout << dp[n][W];  // dp[3][6] = 8",
      "highlights": ["dp[n][W]"],
      "state": {
