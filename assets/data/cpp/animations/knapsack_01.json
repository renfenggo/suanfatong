        "output": ""
      }
    },
    {
      "step": 2,
      "title": "考虑物品 A（重2, 值3）",
      "description": "对容量 j：若 j≥2，可选或不选 A。选：dp[1][j] = dp[0][j-2]+3；不选：dp[1][j] = dp[0][j]。取较大值。dp[1][2]=3, dp[1][3]=3, ..., dp[1][6]=3。",
      "codeLine": "dp[i][j] = max(dp[i-1][j], dp[i-1][j-w[i]] + v[i]);",
      "highlights": ["max", "dp[i-1][j]", "dp[i-1][j-w[i]] + v[i]"],
      "state": {
        "variables": [
          {"name": "i", "value": "1", "note": "物品 A"},
          {"name": "dp[1][6]", "value": "3", "note": "选 A，价值 3"}
        ],
        "containers": [
          {"name": "物品", "type": "物品[]", "values": ["A(重2,值3)", "B(重3,值4)", "C(重4,值5)"], "activeIndex": 0, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "考虑物品 B（重3, 值4）",
      "description": "j≥3 时，dp[2][j] = max(dp[1][j], dp[1][j-3]+4)。dp[2][5] = max(3, 0+4) = 4。dp[2][6] = max(3, 3+4) = 7。",
      "codeLine": "dp[i][j] = max(dp[i-1][j], dp[i-1][j-w[i]] + v[i]);",
      "highlights": ["max"],
      "state": {
        "variables": [
          {"name": "i", "value": "2", "note": "物品 B"},
          {"name": "dp[2][6]", "value": "7", "note": "A+B=3+4=7"}
        ],
        "containers": [
          {"name": "物品", "type": "物品[]", "values": ["A(重2,值3)", "B(重3,值4)", "C(重4,值5)"], "activeIndex": 1, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "考虑物品 C（重4, 值5）",
      "description": "dp[3][6] = max(dp[2][6], dp[2][2]+5) = max(7, 3+5) = 8。选 A+C（重2+4=6，值3+5=8）比 A+B（重5，值7）更优！",
      "codeLine": "dp[i][j] = max(dp[i-1][j], dp[i-1][j-w[i]] + v[i]);",
      "highlights": ["max"],
      "state": {
        "variables": [
          {"name": "i", "value": "3", "note": "物品 C"},
          {"name": "dp[3][6]", "value": "8", "note": "A+C = 3+5 = 8"}
