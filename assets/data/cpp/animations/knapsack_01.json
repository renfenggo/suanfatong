      "title": "定义状态 dp[i][j]",
      "description": "dp[i][j] = 前 i 个物品、背包容量为 j 时的最大价值。边界：dp[0][j]=0（没有物品可选），dp[i][0]=0（容量为 0）。",
      "codeLine": "int dp[4][7] = {};  // 全部初始化为 0",
      "highlights": ["dp[i][j]"],
      "state": {
        "variables": [
          {"name": "状态", "value": "dp[i][j]", "note": "前 i 个物品、容量 j 的最大价值"},
