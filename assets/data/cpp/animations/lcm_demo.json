{
  "animationId": "cpp_lcm_demo",
  "itemId": "4.1.10",
  "title": "最小公倍数（lcm）",
  "description": "演示利用 gcd 求 lcm 的过程：lcm(a,b) = a*b/gcd(a,b)",
  "initialState": {
    "variables": [
      {"name": "a", "value": "12", "note": ""},
      {"name": "b", "value": "18", "note": ""}
    ],
    "containers": [],
    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "初始化",
      "description": "求 lcm(12, 18)，即 12 和 18 的最小公倍数",
      "codeLine": "int a = 12, b = 18;",
      "highlights": ["a", "b"],
      "state": {
        "variables": [
          {"name": "a", "value": "12", "note": ""},
          {"name": "b", "value": "18", "note": ""}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "先求 gcd(12, 18)",
      "description": "用辗转相除法：gcd(12,18) → gcd(18,12) → gcd(12,6) → gcd(6,0) = 6",
      "codeLine": "int g = gcd(a, b); // gcd(12,18) = 6",
      "highlights": ["gcd"],
      "state": {
        "variables": [
          {"name": "a", "value": "12", "note": ""},
          {"name": "b", "value": "18", "note": ""},
          {"name": "gcd", "value": "6", "note": "12→18→12→6→6→0"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "用公式求 lcm",
      "description": "lcm = a / gcd * b = 12 / 6 * 18 = 2 * 18 = 36。先除后乘避免溢出",
      "codeLine": "int l = a / g * b; // 12/6*18 = 36",
      "highlights": ["a / g * b"],
      "state": {
        "variables": [
          {"name": "a", "value": "12", "note": ""},
          {"name": "b", "value": "18", "note": ""},
          {"name": "gcd", "value": "6", "note": ""},
          {"name": "lcm", "value": "36", "note": "12/6×18=36"}
        ],
        "containers": [],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "验证",
      "description": "36 ÷ 12 = 3 ✓，36 ÷ 18 = 2 ✓，36 是 12 和 18 的公倍数且是最小的",
      "codeLine": "cout << l; // 36",
      "highlights": [],
      "state": {
        "variables": [
          {"name": "lcm", "value": "36", "note": "36/12=3, 36/18=2"}
        ],
        "containers": [],
        "output": "lcm(12,18) = 36"
      }
    }
  ]
}
