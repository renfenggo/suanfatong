{
  "animationId": "cpp_pascal_triangle",
  "itemId": "4.3.8",
  "title": "Pascal 三角",
  "description": "演示 Pascal 三角（杨辉三角）的递推构建过程：C(n,k) = C(n-1,k-1) + C(n-1,k)",
  "initialState": {
    "variables": [],
    "containers": [],
    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "第 0 行",
      "description": "Pascal 三角第 0 行只有一个元素 C(0,0) = 1",
      "codeLine": "C[0][0] = 1;",
      "highlights": ["C[0][0]"],
      "state": {
        "variables": [
          {"name": "C[0][0]", "value": "1", "note": ""}
        ],
        "containers": [
          {"name": "第0行", "type": "row", "values": ["1"], "activeIndex": 0, "note": ""}
        ],
        "output": "1"
      }
    },
    {
      "step": 2,
      "title": "第 1 行",
      "description": "第 1 行两端各为 1：C(1,0) = 1, C(1,1) = 1",
      "codeLine": "C[1][0] = 1; C[1][1] = 1;",
      "highlights": ["C[1][0]", "C[1][1]"],
      "state": {
        "variables": [
          {"name": "C[1][0]", "value": "1", "note": ""},
          {"name": "C[1][1]", "value": "1", "note": ""}
        ],
        "containers": [
          {"name": "第0行", "type": "row", "values": ["1"], "activeIndex": -1, "note": ""},
          {"name": "第1行", "type": "row", "values": ["1", "1"], "activeIndex": 0, "note": ""}
        ],
        "output": "1\n1 1"
      }
    },
    {
      "step": 3,
      "title": "第 2 行：递推",
      "description": "C(2,0)=1, C(2,1) = C(1,0)+C(1,1) = 1+1 = 2, C(2,2)=1",
      "codeLine": "C[i][j] = C[i-1][j-1] + C[i-1][j];",
      "highlights": ["C[i-1][j-1] + C[i-1][j]"],
      "state": {
        "variables": [
          {"name": "C[2][1]", "value": "2", "note": "1+1=2"}
        ],
        "containers": [
          {"name": "第0行", "type": "row", "values": ["1"], "activeIndex": -1, "note": ""},
          {"name": "第1行", "type": "row", "values": ["1", "1"], "activeIndex": -1, "note": ""},
          {"name": "第2行", "type": "row", "values": ["1", "2", "1"], "activeIndex": 1, "note": "中间=上方两数之和"}
        ],
        "output": "1\n1 1\n1 2 1"
      }
    },
    {
      "step": 4,
      "title": "第 3 行：继续递推",
      "description": "C(3,1) = C(2,0)+C(2,1) = 1+2 = 3, C(3,2) = C(2,1)+C(2,2) = 2+1 = 3",
      "codeLine": "C[i][j] = C[i-1][j-1] + C[i-1][j];",
      "highlights": ["C[i-1][j-1] + C[i-1][j]"],
      "state": {
        "variables": [
          {"name": "C[3][1]", "value": "3", "note": "1+2=3"},
          {"name": "C[3][2]", "value": "3", "note": "2+1=3"}
        ],
        "containers": [
          {"name": "第0行", "type": "row", "values": ["1"], "activeIndex": -1, "note": ""},
          {"name": "第1行", "type": "row", "values": ["1", "1"], "activeIndex": -1, "note": ""},
          {"name": "第2行", "type": "row", "values": ["1", "2", "1"], "activeIndex": -1, "note": ""},
          {"name": "第3行", "type": "row", "values": ["1", "3", "3", "1"], "activeIndex": 1, "note": ""}
        ],
        "output": "1\n1 1\n1 2 1\n1 3 3 1"
      }
    },
    {
      "step": 5,
      "title": "第 4 行：递推规律",
      "description": "C(4,1)=4, C(4,2)=6, C(4,3)=4。每个数 = 左上方 + 正上方。第 n 行第 k 个数就是 C(n,k)",
      "codeLine": "// 每个数 = 左上 + 右上",
      "highlights": [],
      "state": {
        "variables": [
          {"name": "C[4][2]", "value": "6", "note": "3+3=6"}
        ],
        "containers": [
          {"name": "第0行", "type": "row", "values": ["1"], "activeIndex": -1, "note": ""},
          {"name": "第1行", "type": "row", "values": ["1", "1"], "activeIndex": -1, "note": ""},
          {"name": "第2行", "type": "row", "values": ["1", "2", "1"], "activeIndex": -1, "note": ""},
          {"name": "第3行", "type": "row", "values": ["1", "3", "3", "1"], "activeIndex": -1, "note": ""},
          {"name": "第4行", "type": "row", "values": ["1", "4", "6", "4", "1"], "activeIndex": 2, "note": "C(4,2)=6"}
        ],
        "output": "1\n1 1\n1 2 1\n1 3 3 1\n1 4 6 4 1"
      }
    }
  ]
}
