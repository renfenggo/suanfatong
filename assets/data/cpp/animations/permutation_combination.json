    {
      "step": 3,
      "title": "计算组合数 C(5,3)",
      "description": "C(5,3) = P(5,3) / 3! = 60 / 6 = 10。组合不考虑顺序，需除以 k! 消除重复排列",
      "codeLine": "int C = P / (3 * 2 * 1); // = n! / (k! * (n-k)!)",
      "highlights": ["P / (3 * 2 * 1)"],
