        "containers": [
          {"name": "arr", "type": "int[]", "values": ["3", "1", "4", "2", "5"], "activeIndex": -1, "note": ""},
          {"name": "prefix", "type": "int[]", "values": ["0", "0", "0", "0", "0", "0"], "activeIndex": 0, "note": "prefix[0]=0"}
        ],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "构建 prefix[1] ~ prefix[3]",
      "description": "依次累加：prefix[1]=0+3=3, prefix[2]=3+1=4, prefix[3]=4+4=8",
      "codeLine": "for (int i = 0; i < n; i++) prefix[i+1] = prefix[i] + arr[i];",
      "highlights": ["prefix[i+1]", "prefix[i] + arr[i]"],
      "state": {
        "variables": [
          {"name": "i", "value": "2", "note": "已处理 arr[0..2]"}
        ],
        "containers": [
          {"name": "arr", "type": "int[]", "values": ["3", "1", "4", "2", "5"], "activeIndex": 2, "note": ""},
          {"name": "prefix", "type": "int[]", "values": ["0", "3", "4", "8", "0", "0"], "activeIndex": 3, "note": "prefix[3]=8"}
        ],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "构建完成",
      "description": "继续累加：prefix[4]=8+2=10, prefix[5]=10+5=15。前缀和构建完成。",
      "codeLine": "for (int i = 0; i < n; i++) prefix[i+1] = prefix[i] + arr[i];",
      "highlights": ["prefix"],
      "state": {
        "variables": [
          {"name": "i", "value": "4", "note": "全部处理完"}
        ],
        "containers": [
          {"name": "arr", "type": "int[]", "values": ["3", "1", "4", "2", "5"], "activeIndex": -1, "note": ""},
          {"name": "prefix", "type": "int[]", "values": ["0", "3", "4", "8", "10", "15"], "activeIndex": 5, "note": "构建完成 ✓"}
        ],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "查询区间和 [1, 3]",
      "description": "求 arr[1]~arr[3] 的和。用公式：sum(l,r) = prefix[r+1] - prefix[l] = prefix[4] - prefix[1] = 10 - 3 = 7。",
      "codeLine": "int sum = prefix[r+1] - prefix[l];  // l=1, r=3",
      "highlights": ["prefix[r+1]", "prefix[l]"],
      "state": {
        "variables": [
          {"name": "l", "value": "1", "note": ""},
