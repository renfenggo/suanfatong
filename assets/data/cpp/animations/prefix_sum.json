    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "初始化 prefix[0] = 0",
      "description": "前缀和数组比原数组多一个元素，prefix[0] = 0 作为基准。prefix[i+1] = prefix[i] + arr[i]。",
      "codeLine": "prefix[0] = 0;",
      "highlights": ["prefix[0]"],
      "state": {
        "variables": [
          {"name": "i", "value": "0", "note": ""}
