    ],
    "containers": [
      {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": "3x3 原始矩阵"},
      {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "?", "?", "?"], ["0", "?", "?", "?"], ["0", "?", "?", "?" ]], "activeIndex": -1, "note": "4x4 前缀和（多一行一列）"}
    ],
    "output": ""
  },
  "steps": [
    {
      "step": 1,
      "title": "初始化第 0 行和第 0 列为 0",
      "description": "二维前缀和矩阵 S 比 a 多一行一列。S[0][*] 和 S[*][0] 全部为 0，表示空区域的和为 0。",
      "codeLine": "memset(S, 0, sizeof(S));  // 第 0 行和第 0 列全为 0",
      "highlights": ["S[0]", "S[*][0]"],
      "state": {
        "variables": [
          {"name": "递推公式", "value": "S[i+1][j+1] = a[i][j] + S[i][j+1] + S[i+1][j] - S[i][j]", "note": ""}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": ""},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "?", "?", "?"], ["0", "?", "?", "?"], ["0", "?", "?", "?" ]], "activeIndex": -1, "note": "边界已初始化"}
        ],
        "output": ""
      }
    },
    {
      "step": 2,
      "title": "构建 S[1][1] = 1",
      "description": "S[1][1] = a[0][0] + S[0][1] + S[1][0] - S[0][0] = 1 + 0 + 0 - 0 = 1。表示 (0,0) 到 (0,0) 的子矩阵和。",
      "codeLine": "S[1][1] = a[0][0] + S[0][1] + S[1][0] - S[0][0];  // = 1",
      "highlights": ["S[1][1]"],
      "state": {
        "variables": [
          {"name": "当前", "value": "S[1][1] = 1", "note": ""}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": ""},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "?", "?"], ["0", "?", "?", "?"], ["0", "?", "?", "?" ]], "activeIndex": -1, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "构建第一行 S[1][2]=4, S[1][3]=6",
      "description": "S[1][2] = a[0][1] + S[0][2] + S[1][1] - S[0][1] = 3+0+1-0 = 4。S[1][3] = a[0][2]+S[0][3]+S[1][2]-S[0][2] = 2+0+4-0 = 6。第一行构建完成。",
      "codeLine": "S[1][j+1] = a[0][j] + S[0][j+1] + S[1][j] - S[0][j];",
      "highlights": ["S[1][2]", "S[1][3]"],
      "state": {
        "variables": [
          {"name": "第一行 S", "value": "[0, 1, 4, 6]", "note": "即累加第 0 行"}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": 0, "note": "第 0 行处理完"},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "4", "6"], ["0", "?", "?", "?"], ["0", "?", "?", "?" ]], "activeIndex": -1, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 4,
      "title": "构建第二行 S[2][1]=5, S[2][2]=9, S[2][3]=16",
      "description": "S[2][1] = a[1][0]+S[1][1]+S[2][0]-S[1][0] = 4+1+0-0 = 5。S[2][2] = a[1][1]+S[1][2]+S[2][1]-S[1][1] = 1+4+5-1 = 9。S[2][3] = a[1][2]+S[1][3]+S[2][2]-S[1][2] = 5+6+9-4 = 16。容斥：加上方+加左方-减重复(左上)。",
      "codeLine": "S[2][j+1] = a[1][j] + S[1][j+1] + S[2][j] - S[1][j];",
      "highlights": ["S[2][2]", "容斥"],
      "state": {
        "variables": [
          {"name": "容斥", "value": "加上方 + 加左方 - 减重复(左上)", "note": "S[1][1] 被加了两次，要减回去"}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": 1, "note": "正在处理第 1 行"},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "4", "6"], ["0", "5", "9", "16"], ["0", "?", "?", "?" ]], "activeIndex": -1, "note": ""}
        ],
        "output": ""
      }
    },
    {
      "step": 5,
      "title": "构建第三行，S 完成",
      "description": "S[3][1] = a[2][0]+S[2][1]+S[3][0]-S[2][0] = 2+5+0-0 = 7。S[3][2] = a[2][1]+S[2][2]+S[3][1]-S[2][1] = 6+9+7-5 = 17。S[3][3] = a[2][2]+S[2][3]+S[3][2]-S[2][2] = 3+16+17-9 = 27。S[3][3]=27 即整个矩阵元素和 = 1+3+2+4+1+5+2+6+3 = 27，验证正确。",
      "codeLine": "S[3][j+1] = a[2][j] + S[2][j+1] + S[3][j] - S[2][j];",
      "highlights": ["S[3][3]"],
      "state": {
        "variables": [
          {"name": "总和验证", "value": "S[3][3] = 27 = 1+3+2+4+1+5+2+6+3", "note": "正确"}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": ""},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "4", "6"], ["0", "5", "9", "16"], ["0", "7", "17", "27" ]], "activeIndex": -1, "note": "构建完成，S[3][3]=27"}
        ],
        "output": ""
      }
    },
    {
      "step": 6,
      "title": "查询子矩阵 (1,1) 到 (2,2)",
      "description": "求 a[1][1]+a[1][2]+a[2][1]+a[2][2] = 1+5+6+3 = 15。容斥公式：S[r2+1][c2+1] - S[r1][c2+1] - S[r2+1][c1] + S[r1][c1] = S[3][3] - S[1][3] - S[3][1] + S[1][1] = 27 - 6 - 7 + 1 = 15。验证正确。",
      "codeLine": "int sum = S[r2+1][c2+1] - S[r1][c2+1] - S[r2+1][c1] + S[r1][c1];",
      "highlights": ["S[3][3]", "S[1][3]", "S[3][1]", "S[1][1]"],
      "state": {
        "variables": [
          {"name": "查询区域", "value": "(r1=1,c1=1) -> (r2=2,c2=2)", "note": "右下 2x2"},
          {"name": "容斥计算", "value": "27-6-7+1 = 15", "note": "验证: 1+5+6+3=15"}
        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": "查询区域: a[1][1],a[1][2],a[2][1],a[2][2]"},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "4", "6"], ["0", "5", "9", "16"], ["0", "7", "17", "27" ]], "activeIndex": -1, "note": "S[3][3]-S[1][3]-S[3][1]+S[1][1]"}
        ],
        "output": "子矩阵 (1,1)->(2,2) 的和 = 15"
      }
    },
    {
      "step": 7,
      "title": "容斥原理图解",
      "description": "查询区域 = S[r2+1][c2+1]（整个大矩形）- S[r1][c2+1]（上方多余）- S[r2+1][c1]（左方多余）+ S[r1][c1]（被减了两次，加回来）。这就是容斥原理，子矩阵查询 O(1)。",
      "codeLine": "// sum = 大矩形 - 上方 - 左方 + 左上角",
      "highlights": ["容斥原理", "O(1) 查询"],
      "state": {
        "variables": [
          {"name": "核心思想", "value": "容斥原理", "note": "大方块 - 上方 - 左方 + 左上"},
