        ],
        "containers": [
          {"name": "矩阵 a", "type": "matrix", "values": [["1", "3", "2"], ["4", "1", "5"], ["2", "6", "3"]], "activeIndex": -1, "note": ""},
          {"name": "前缀和 S", "type": "matrix", "values": [["0", "0", "0", "0"], ["0", "1", "4", "6"], ["0", "5", "9", "16"], ["0", "7", "17", "27" ]], "activeIndex": -1, "note": "容斥查四块角"}
        ],
        "output": "二维前缀和：构建 O(n*m)，查询 O(1)"
      }
    }
  ]
}
