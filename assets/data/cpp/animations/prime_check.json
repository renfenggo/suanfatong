    {
      "step": 2,
      "title": "试除 i=2",
      "description": "29 % 2 = 1 ≠ 0，2 不能整除 29，继续",
      "codeLine": "if (n % i == 0) break;",
      "highlights": ["n % i"],
      "state": {
        "variables": [
          {"name": "n", "value": "29", "note": ""},
