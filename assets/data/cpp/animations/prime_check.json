        "containers": [],
        "output": ""
      }
    },
    {
      "step": 3,
      "title": "试除 i=3、i=4、i=5",
      "description": "29%3=2≠0, 29%4=1≠0, 29%5=4≠0，均不能整除",
      "codeLine": "if (n % i == 0) break;",
      "highlights": ["n % i"],
      "state": {
        "variables": [
          {"name": "n", "value": "29", "note": ""},
