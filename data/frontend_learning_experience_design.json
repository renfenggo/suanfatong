    "recommendation_score": {
      "type": "number",
      "range": "0-1",
      "derivation_method": "基于依赖满足度、进度相关性、重要性综合计算",
      "storage_location": "runtime_cache"
    },
    
    "learning_readiness": {
      "type": "object",
      "fields": {
