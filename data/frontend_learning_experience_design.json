  "core_solutions": {
    "avoid_overwhelm": {
      "problem": "3240个知识点平铺展示造成压迫感",
      "solutions": [
        "分层展示：首页3-5个，章节页10-20个",
        "个性化过滤：基于进度只显示相关内容",
        "心理暗示：强调当前路径和短期目标"
      ]
    },
    
    "show_prerequisites": {
      "problem": "如何展示先学这些/学完继续",
      "solutions": [
        "入口提示：卡片上显示前置状态标签",
        "前置知识页：按重要性排序显示",
        "底部固定栏：显示下一步推荐"
      ]
    },
    
    "learning_cards": {
      "problem": "如何展示学习卡片",
      "solutions": [
        "信息层次：标题 > 描述 > 元信息",
        "状态标识：已学完/学习中/未学习/锁定",
        "视觉吸引力：留白、圆角、阴影、图标"
      ]
    },
    
    "content_categorization": {
      "problem": "如何做核心主线、进阶、扩展、冷门折叠",
      "solutions": [
        "核心主线：必学内容，始终展开",
        "进阶内容：学完核心后推荐，默认折叠",
        "扩展内容：深入学习材料，深度折叠",
        "冷门内容：特殊场景，需要主动搜索"
      ]
    },
    
    "progress_based_recommendation": {
      "problem": "如何结合学习进度推荐下一步",
      "solutions": [
        "基于依赖：推荐前置条件已满足的内容",
        "基于连续性：优先同章节内容",
        "基于难度：避免跨度过大",
        "基于兴趣：分析学习偏好"
      ]
    },
    
    "search_result_sorting": {
      "problem": "搜索结果如何排序更适合学习",
      "solutions": [
        "学习推荐排序：就绪度 > 相关性 > 重要性",
        "相关性排序：关键词匹配度 > 主题相关度",
        "难度排序：从易到难，考虑当前水平",
        "结果分组：最佳路径 > 相关内容 > 需要前置"
      ]
    }
  },
  
  "avoid_complex_features": {
    "not_recommended": [
      {
        "feature": "复杂AI推荐系统",
        "reason": "基于机器学习的个性化推荐过于复杂",
        "alternative": "基于规则的简单推荐（依赖关系+进度）"
      },
      {
        "feature": "社交功能",
        "reason": "学习社区、排行榜等分散学习注意力",
        "alternative": "专注于个人学习体验"
      },
      {
        "feature": "过度游戏化",
        "reason": "复杂成就系统、等级系统增加复杂度",
        "alternative": "简单的进度庆祝和连续学习记录"
      },
      {
        "feature": "复杂自适应学习",
        "reason": "根据答题表现动态调整难度技术复杂",
        "alternative": "基于用户选择的学习路径"
      },
      {
        "feature": "多媒体内容制作",
        "reason": "视频课程、音频讲解制作成本高",
        "alternative": "基于现有动画数据的演示"
      }
    ],
    "design_principles": [
      "保持简单有效",
      "专注核心学习价值",
      "避免功能膨胀",
      "优先用户体验而非功能数量"
    ]
  },
  
